logs/
__pycache__/
.vscode/
_build/

.ci-keep/

# Override global gitignore for dotfiles that must be tracked
!.github/
!.cog.toml

# Bazel-specific ignores
bazel-*
.bazelrc.user

# uv-managed virtualenv (uv also writes .venv/.gitignore; this is belt-and-suspenders)
.venv/
# Bazel is the source of truth for deps; uv.lock from `uv run` against the bare pyproject.toml is spurious
uv.lock

*.swp
*.swo
